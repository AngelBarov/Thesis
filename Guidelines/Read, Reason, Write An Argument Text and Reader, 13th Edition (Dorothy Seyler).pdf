            <rdf:Alt>
               <rdf:li xml:lang="x-default">21749496</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2010 The Washington Post</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">WEST POINT, NY -  August 24: U.S. Army Major Walt Cooper, who served with the 101st battalion in Iraq graduated from West Point and now teaches American Politics at the United States Military Academy.  He encourages the cadets to join the discussion Tuesday August 24, in West Point, NY. (Photo by Katherine Frey/The Washington Post via Getty Images)</rdf:li>
            </rdf:Alt>
         </dc:description>
