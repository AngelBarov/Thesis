            xmlns:plus="http://ns.useplus.org/ldf/xmp/1.0/">
         <photoshop:Category>A</photoshop:Category>
         <photoshop:Source>Getty Images North America</photoshop:Source>
         <photoshop:City>Washington</photoshop:City>
         <photoshop:AuthorsPosition>Staff</photoshop:AuthorsPosition>
         <photoshop:CopyrightFlag>true</photoshop:CopyrightFlag>
         <photoshop:Country>United States</photoshop:Country>
         <photoshop:DateCreated>2017-02-21T08:00</photoshop:DateCreated>
         <photoshop:Credit>Getty Images</photoshop:Credit>
         <photoshop:TransmissionReference>700006431</photoshop:TransmissionReference>
         <photoshop:Headline>Cornel West And Malik Shabazz Discuss Trump's Impact On Black Communities</photoshop:Headline>
         <photoshop:URL>https://www.gettyimages.com</photoshop:URL>
         <photoshop:Instructions>Not Released (NR) </photoshop:Instructions>
         <photoshop:CaptionWriter>wm</photoshop:CaptionWriter>
         <photoshop:State>DC</photoshop:State>
         <photoshop:LegacyIPTCDigest>3D28FB6E9D6742706A1A18D1AAAC5B96</photoshop:LegacyIPTCDigest>
         <photoshop:Urgency>2</photoshop:Urgency>
         <photoshop:ColorMode>4</photoshop:ColorMode>
         <photoshop:ICCProfile>U.S. Web Coated (SWOP) v2</photoshop:ICCProfile>
         <photoshop:SupplementalCategories>
            <rdf:Bag>
               <rdf:li>POL</rdf:li>
            </rdf:Bag>
         </photoshop:SupplementalCategories>
         <dc:Rights>2017 Getty Images</dc:Rights>
         <dc:format>image/epsf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">643522944</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Win McNamee</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">WASHINGTON, DC - FEBRUARY 21:  Cornel West, professor of philosophy at Union Theological Seminary, speaks at the National Press Club February 21, 2017 in Washington, DC. West and other African American leaders discussed "the current statements and actions of the president of the United States and their impact on the African American community" during their remarks.  (Photo by Win McNamee/Getty Images)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2017 Getty Images</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <Iptc4xmpCore:CountryCode>USA</Iptc4xmpCore:CountryCode>
         <GettyImagesGIFT:Dlref>P20DW4VYdjqfQV9MPXt7ww==</GettyImagesGIFT:Dlref>
         <GettyImagesGIFT:ImageRank>2</GettyImagesGIFT:ImageRank>
         <GettyImagesGIFT:AssetID>643522944</GettyImagesGIFT:AssetID>
         <xmpRights:WebStatement>https://www.gettyimages.com/eula?utm_medium=organic&amp;utm_source=google&amp;utm_campaign=iptcurl</xmpRights:WebStatement>
