         <photoshop:Credit>Washington Post/Getty Images</photoshop:Credit>
         <photoshop:Headline>Walt Cooper, a member of the Army's 101st  Brigade that went to Iraq in 2003,  attended West Point and now teaches  American Politics at the United States Military Academy</photoshop:Headline>
         <photoshop:City>West point</photoshop:City>
         <photoshop:Source>The Washington Post</photoshop:Source>
         <photoshop:Country>United States</photoshop:Country>
         <photoshop:State>NY</photoshop:State>
         <photoshop:Category>A</photoshop:Category>
