         <dc:format>image/epsf</dc:format>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>REUTERS / Alamy Stock Photo</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2CYRW59 Off-duty Boeing employee Art Duffy watches as CNN announced on TV that the U.S. Air Force declared Boeing's 767 the winner of an epic $35 billion, 10-year procurement battle against European-based Airbus over 179 aerial refueling planes, at a saloon in Everett, Washington, February 24, 2011. This contract affects the more than 70,000 Washington State and the more than 2,500 Kansas State Boeing employees where the 767 airplane components are manufactured.   REUTERS/Anthony Bolante (UNITED STATES - Tags: MILITARY BUSINESS EMPLOYMENT)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2CYRW59</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Credit: REUTERS / Alamy Stock Photo</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:subject>
            <rdf:Bag>
